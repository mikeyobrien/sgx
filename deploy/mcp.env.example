# Copy to ~/.sgx/mcp.env and chmod 600. Read by the sgx-mcp systemd unit.
# Generate secrets with: openssl rand -base64 24

# Password the operator types on the OAuth consent page when a client
# (e.g. Muse) connects. REQUIRED for Claude custom connectors.
SGX_MCP_PASSWORD=change-me

# Optional static bearer token for scripted clients (MCP Inspector, smoke
# tests). Muse connectors use OAuth above, not this.
SGX_MCP_TOKEN=

# Public base URL clients use to reach this server (no trailing path).
# The MCP endpoint to give Muse is: <issuer>/mcp
SGX_MCP_ISSUER_URL=https://your-host.example.net

# Optional bind overrides (defaults shown).
#SGX_MCP_HOST=127.0.0.1
#SGX_MCP_PORT=8321
